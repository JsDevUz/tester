{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:capacitor": "tsc -b && vite build --mode capacitor",
    "cap:sync": "npm run build:capacitor && cap sync",
    "cap:android": "npm run cap:sync && cap run android",
    "cap:ios": "npm run cap:sync && cap run ios",
    "cap:open:android": "cap open android",
    "cap:open:ios": "cap open ios",
    "lint": "oxlint",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@blocknote/core": "^0.51.4",
    "@blocknote/mantine": "^0.51.4",
    "@blocknote/react": "^0.51.4",
    "@capacitor/android": "^8.4.2",
    "@capacitor/app": "^8.1.1",
    "@capacitor/core": "^8.4.2",
    "@capacitor/ios": "^8.4.2",
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@tailwindcss/vite": "^4.3.2",
    "axios": "^1.18.1",
    "hls.js": "^1.6.16",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "katex": "^0.18.1",
    "livekit-client": "^2.20.1",
    "lucide-react": "^1.22.0",
    "perfect-freehand": "^1.2.3",
    "react": "^19.2.7",
    "react-confetti": "^6.4.0",
    "react-dom": "^19.2.7",
    "react-hotkeys-hook": "^5.3.3",
    "react-pdf": "^10.4.1",
    "react-router-dom": "^7.18.1",
    "socket.io-client": "^4.8.3",
    "sonner": "^2.0.7",
    "tailwindcss": "^4.3.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.4.2",
    "@types/node": "^24.13.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.2",
    "jsdom": "^27.0.1",
    "oxlint": "^1.69.0",
    "typescript": "~6.0.2",
    "vite": "^8.1.0",
    "vitest": "^3.2.7"
  }
