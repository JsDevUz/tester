FROM python:3.11-slim

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
    ffmpeg \
    && rm -rf /var/lib/apt/lists/*

COPY subtitle_server.py /app/

RUN pip install --no-cache-dir faster-whisper fastapi uvicorn pydantic python-multipart

EXPOSE 8090

CMD ["python3", "subtitle_server.py"]
