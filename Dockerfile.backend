FROM node:22-alpine AS deps

WORKDIR /app

COPY package*.json ./
COPY apps/backend/package*.json apps/backend/
COPY apps/frontend/package*.json apps/frontend/
RUN npm ci

FROM deps AS build

COPY apps/backend apps/backend
RUN npm run build --workspace=apps/backend

FROM node:22-alpine AS runner

WORKDIR /app
ENV NODE_ENV=production
# Konteynerda backend shu portda tinglaydi. main.ts'dagi fallback (3001)
# faqat lokal ishlab chiqish uchun — bu yerda PORT aniq beriladi, shunda
# EXPOSE, docker-compose va nginx/Caddy upstream'lari bir xil portga
# ishora qiladi.
ENV PORT=3000
RUN apk add --no-cache ffmpeg

COPY --from=deps /app/package*.json ./
COPY --from=deps /app/node_modules node_modules
COPY --from=deps /app/apps/backend/package*.json apps/backend/
COPY --from=build /app/apps/backend apps/backend
COPY docker/backend-entrypoint.sh /app/backend-entrypoint.sh
RUN chmod +x /app/backend-entrypoint.sh

EXPOSE 3000
ENTRYPOINT ["/app/backend-entrypoint.sh"]
